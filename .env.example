# Net-Sniff Docker Environment Configuration
# Copy this file to .env and customize the values for your network

# Network subnet to scan in CIDR notation
# Update this to match your local network
SUBNET=192.168.1.0/24

# Scan interval in seconds (300 = 5 minutes)
# Lower values = more frequent scans, higher network load
SCAN_INTERVAL=300

# Scan timeout in seconds per device
# Higher values = more accurate results, slower scans
SCAN_TIMEOUT=2.0

# Container restart policy
# Options: no, always, unless-stopped, on-failure
RESTART_POLICY=unless-stopped

# Log level for the application
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO